<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Controls"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Status -->
    <TextView
        android:id="@+id/tv_main_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to enable blocking"
        android:textColor="#90FFFFFF"
        android:textSize="12sp" />

    <!-- Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- App Blocking Toggle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_toggle_blocking"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle"
                android:backgroundTint="#757575"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_blocking_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="App Blocking OFF"
                android:textColor="#90FFFFFF"
                android:textSize="8sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- VPN Toggle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_toggle_vpn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle"
                android:backgroundTint="#757575"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_vpn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Internet Block OFF"
                android:textColor="#90FFFFFF"
                android:textSize="8sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Quick Focus -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_quick_focus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle"
                android:backgroundTint="#2196F3"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_focus_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quick Focus"
                android:textColor="#90FFFFFF"
                android:textSize="8sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- Service Indicators -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/indicator_accessibility"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/circle"
            android:backgroundTint="#F44336" />

        <View
            android:id="@+id/indicator_vpn"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle"
            android:backgroundTint="#F44336" />

        <View
            android:id="@+id/indicator_focus"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle"
            android:backgroundTint="#F44336" />

    </LinearLayout>

    <!-- Last Updated -->
    <TextView
        android:id="@+id/tv_last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Updated just now"
        android:textColor="#60FFFFFF"
        android:textSize="8sp"
        android:gravity="center" />

</LinearLayout>