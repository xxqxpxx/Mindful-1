<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Awaytime Button Styles -->
    <style name="AwayTimeButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/awaytime_purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
    </style>

    <style name="AwayTimeButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/awaytime_purple</item>
        <item name="strokeColor">@color/awaytime_purple</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
    </style>

    <style name="AwayTimeButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/awaytime_purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_height">48dp</item>
    </style>

    <!-- Awaytime Card Styles -->
    <style name="AwayTimeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/awaytime_card_background</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="AwayTimeCard.Flat">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/awaytime_card_background</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Text Styles -->
    <style name="AwayTimeText" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AwayTimeText.Headline" parent="AwayTimeText">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/awaytime_purple</item>
    </style>

    <style name="AwayTimeText.Title" parent="AwayTimeText">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AwayTimeText.Subtitle" parent="AwayTimeText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/gray_600</item>
    </style>

    <style name="AwayTimeText.Body" parent="AwayTimeText">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AwayTimeText.Caption" parent="AwayTimeText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_500</item>
    </style>

    <!-- Progress Styles -->
    <style name="AwayTimeProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/awaytime_purple</item>
        <item name="android:progressBackgroundTint">@color/awaytime_light_purple</item>
        <item name="android:layout_height">8dp</item>
    </style>

    <style name="AwayTimeProgressBar.Circular" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/awaytime_purple</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
    </style>

    <!-- Input Styles -->
    <style name="AwayTimeTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/awaytime_purple</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/awaytime_purple</item>
        <item name="android:layout_marginHorizontal">16dp</item>
    </style>

    <!-- Switch Styles -->
    <style name="AwayTimeSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:thumbTint">@color/awaytime_purple</item>
        <item name="android:trackTint">@color/awaytime_light_purple</item>
    </style>

    <!-- Chip Styles -->
    <style name="AwayTimeChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/awaytime_light_purple</item>
        <item name="android:textColor">@color/awaytime_dark_purple</item>
        <item name="chipStrokeColor">@color/awaytime_purple</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- Dialog Styles -->
    <style name="AwayTimeDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/awaytime_purple</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Bottom Sheet Styles -->
    <style name="AwayTimeBottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">@color/awaytime_purple</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Toolbar Styles -->
    <style name="AwayTimeToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/awaytime_purple</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/awaytime_light_purple</item>
    </style>

    <!-- Tab Layout Styles -->
    <style name="AwayTimeTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/awaytime_purple</item>
        <item name="tabSelectedTextColor">@color/awaytime_purple</item>
        <item name="tabTextColor">@color/gray_600</item>
        <item name="tabIndicatorHeight">3dp</item>
    </style>

    <!-- Floating Action Button Styles -->
    <style name="AwayTimeFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/awaytime_purple</item>
        <item name="tint">@color/white</item>
    </style>

    <!-- Snackbar Styles -->
    <style name="AwayTimeSnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@color/awaytime_dark_purple</item>
    </style>
</resources>